          <dc:Bounds x="168" y="225" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0lvlpmv_di" bpmnElement="Gateway_0e9fyqz" isMarkerVisible="true">
        <dc:Bounds x="465" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="469" y="232" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_1ahkb5p" bpmnElement="UpdateOrder">
        <dc:Bounds x="750" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_0l9vk4o" bpmnElement="AddShipping">
        <dc:Bounds x="580" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1goif75_di" bpmnElement="Event_1goif75">
        <dc:Bounds x="952" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="225" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_0tj6hs6" bpmnElement="CheckStock">
        <dc:Bounds x="280" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1gf55td_di" bpmnElement="Flow_1gf55td">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="280" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19lirif_di" bpmnElement="Flow_19lirif">
        <di:waypoint x="490" y="175" />
        <di:waypoint x="490" y="120" />
