        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://ait-training-training-be.ait-training.svc.cluster.local:80/v1/OrderD/UpdateOrderNotesAndStatRFA</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="content-type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "id": ${Order.orderHId}
}
</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06aa5tx</bpmn:incoming>
      <bpmn:outgoing>Flow_1sghxoc</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1sghxoc" sourceRef="Activity_06ao9uh" targetRef="ApproveShippingRequest" />
  </bpmn:process>
