<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_17nc6rg" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.32.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:process id="OrderManagement" name="Order Management" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartProcess" name="Start Process" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_18onm49</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1nmxhtv" name="Stock Available? and Id No Valid?">
      <bpmn:incoming>Flow_1uxo1v8</bpmn:incoming>
      <bpmn:outgoing>Flow_06aa5tx</bpmn:outgoing>
      <bpmn:outgoing>Flow_14bz1m7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_06qsueq" name="Check Product Stock and Cust IDNo" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_18onm49</bpmn:incoming>
      <bpmn:outgoing>Flow_0u1oao7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0zal17h</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndProcess" name="End Process">
      <bpmn:incoming>Flow_123l68a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ApproveShippingRequest" name="Approve Shipping Request" camunda:asyncBefore="true" camunda:candidateUsers="SUPUSR">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1sghxoc</bpmn:incoming>
      <bpmn:outgoing>Flow_1fzn39o</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0t655sf" name="Approved?">
      <bpmn:incoming>Flow_1fzn39o</bpmn:incoming>
      <bpmn:outgoing>Flow_0igxvm7</bpmn:outgoing>
      <bpmn:outgoing>Flow_1lsvknk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_11h2tc5" name="Converging Gateway">
      <bpmn:incoming>Flow_12kljdx</bpmn:incoming>
      <bpmn:incoming>Flow_0uvxr8g</bpmn:incoming>
      <bpmn:outgoing>Flow_1uxo1v8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_18onm49" sourceRef="StartProcess" targetRef="Gateway_06qsueq" />
    <bpmn:sequenceFlow id="Flow_0u1oao7" name="Check Product Stock" sourceRef="Gateway_06qsueq" targetRef="CheckProductStock" />
    <bpmn:sequenceFlow id="Flow_0zal17h" name="Check Cust Id Number" sourceRef="Gateway_06qsueq" targetRef="CheckNegativeCust" />
    <bpmn:sequenceFlow id="Flow_0igxvm7" name="Jika di approve" sourceRef="Gateway_0t655sf" targetRef="AddShipping">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1lsvknk" name="Jika tidak di approve&#10;" sourceRef="Gateway_0t655sf" targetRef="UpdateOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1uxo1v8" sourceRef="Gateway_11h2tc5" targetRef="Gateway_1nmxhtv" />
    <bpmn:sequenceFlow id="Flow_1fzn39o" sourceRef="ApproveShippingRequest" targetRef="Gateway_0t655sf" />
    <bpmn:sequenceFlow id="Flow_06aa5tx" name="Stock Cukup &#38; Id No &#62; 16 Digit&#10;" sourceRef="Gateway_1nmxhtv" targetRef="Activity_06ao9uh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${IsStockAvailable == true &amp;&amp; IsValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14bz1m7" name="Stock Kurang / Id No &#60; 16 Digit" sourceRef="Gateway_1nmxhtv" targetRef="UpdateOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${IsStockAvailable == false || IsValid == false }</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="UpdateOrder" name="Update Order" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://ait-training-training-be.ait-training.svc.cluster.local:80/v1/OrderD/UpdateOrderNotesAndStat</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="content-type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "orderHId": ${Order.orderHId},
  "orderStat": "${OrderStat}",
  "notes": "${Notes}"
}</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14bz1m7</bpmn:incoming>
      <bpmn:incoming>Flow_0jzmbpx</bpmn:incoming>
      <bpmn:incoming>Flow_1lsvknk</bpmn:incoming>
      <bpmn:outgoing>Flow_123l68a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CheckProductStock" name="Check Product Stock" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://ait-training-training-be.ait-training.svc.cluster.local:80/v1/Product/CheckProductStock</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="content-type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "id": ${Order.orderHId}
}
</camunda:inputParameter>
            <camunda:outputParameter name="IsStockAvailable">${S(response).prop("IsStockAvailable").boolValue()}</camunda:outputParameter>
            <camunda:outputParameter name="OrderStat">${S(response).prop("OrderStat")}</camunda:outputParameter>
            <camunda:outputParameter name="Notes">${S(response).prop("Notes")}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0u1oao7</bpmn:incoming>
      <bpmn:outgoing>Flow_12kljdx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_12kljdx" sourceRef="CheckProductStock" targetRef="Gateway_11h2tc5" />
    <bpmn:serviceTask id="CheckNegativeCust" name="Check Negative Customer" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://ait-training-training-be.ait-training.svc.cluster.local:80/v1/Cust/CheckNegativeCustomer</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="content-type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "id": ${Order.orderHId}
}</camunda:inputParameter>
            <camunda:outputParameter name="IsValid">${S(response).prop("IsValid").boolValue()}</camunda:outputParameter>
            <camunda:outputParameter name="OrderStat">${S(response).prop("OrderStat").stringValue()}</camunda:outputParameter>
            <camunda:outputParameter name="Notes">${S(response).prop("Notes").stringValue()}
</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zal17h</bpmn:incoming>
      <bpmn:outgoing>Flow_0uvxr8g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0uvxr8g" sourceRef="CheckNegativeCust" targetRef="Gateway_11h2tc5" />
    <bpmn:serviceTask id="AddShipping" name="Add Shipping" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://ait-training-training-be.ait-training.svc.cluster.local:80/v1/Shipping/AddShipping</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="content-type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "orderHId": "${Order.orderHId}"
}</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0igxvm7</bpmn:incoming>
      <bpmn:outgoing>Flow_0jzmbpx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0jzmbpx" sourceRef="AddShipping" targetRef="UpdateOrder" />
    <bpmn:sequenceFlow id="Flow_123l68a" sourceRef="UpdateOrder" targetRef="EndProcess" />
    <bpmn:serviceTask id="Activity_06ao9uh" name="Update Order Notes and Stat" camunda:asyncBefore="true">
