  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "large-serve": "node --max_old_space_size=2048 ./node_modules/@angular/cli/bin/ng serve",
    "build": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production --aot --base-href /Foundation/",
    "dev": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=dev --base-href /FOUNDATION_DEV/",
    "devTest": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=devTest --base-href /FOUNDATION_DEV_TEST/",
    "sit": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=sit --base-href /FOUNDATION/",
    "demo": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=demo_env --base-href /DEMO_BSI/FOUNDATION_DEMO_BSI/",
    "integration": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=integration_env --base-href /FOUNDATION_INTEGRATION/",
    "stresstest": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=test_env --base-href /FOUNDATION_FE/",
    "https": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=https_env --base-href /FOUNDATION_HTTPS/",
    "OPL": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=OPL --aot --base-href /Foundation/",
    "OPLsit": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=OPLsit --aot --base-href /FOUNDATION_FE_OPL_SIT/",
    "1_4_16": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=1_4_16_env --base-href /1.4.16/FOUNDATION/",
    "test": "ng test",
    "version:patch": "npm version prerelease -m UpVersion && git push origin HEAD:master --follow-tags --force",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "dev:ssr": "ng run matngular:serve-ssr",
    "serve:ssr": "node dist/matngular/server/main.js",
    "build:ssr": "ng build && ng run matngular:server",
    "prerender": "ng run matngular:prerender",
    "rename": "node -e \"require('fs').rename('dist/matngular/browser/assets/enviConfig.dev.json', 'dist/matngular/browser/assets/enviConfig.json', function(err) { if (err) console.log(err); else console.log('File successfully renamed!') })\""
