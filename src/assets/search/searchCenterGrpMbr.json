    "querystring": {
        "select": "SELECT A.CENTER_GRP_OFFICE_MBR_ID as CenterGrpId,B.OFFICE_CODE as officeCode,B.OFFICE_NAME as officeName,B.OFFICE_ADDR as officeAddr",
        "from": "FROM CENTER_GRP_OFFICE_MBR A WITH(NOLOCK) INNER JOIN REF_OFFICE B WITH(NOLOCK)  ON A.REF_OFFICE_ID = B.REF_OFFICE_ID"
    },
