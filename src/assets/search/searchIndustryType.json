    "querystring": { 
      "select": "SELECT A.REF_INDUSTRY_TYPE_ID AS refIndustryTypeId, A.INDUSTRY_TYPE_CODE AS industryTypeCode, A.INDUSTRY_TYPE_NAME AS industryTypeName, B.ECONOMIC_SECTOR_NAME AS economicSectorName, A.IS_ACTIVE AS isActive",
      "from": "FROM REF_INDUSTRY_TYPE AS A WITH(NOLOCK) INNER JOIN REF_ECONOMIC_SECTOR AS B WITH(NOLOCK) ON A.REF_ECONOMIC_SECTOR_ID = B.REF_ECONOMIC_SECTOR_ID",
      "where": "A.IS_ACTIVE = 1"
