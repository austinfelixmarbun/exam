  "querystring": {
    "select": "SELECT REF_MASTER_ID AS refMasterId, MASTER_CODE AS masterCode, DESCR AS descr, SEQ_NO AS seqNo, IS_ACTIVE AS isActive, IS_SYSTEM AS isSystem",
    "from": "FROM REF_MASTER WITH(NOLOCK)"
  },
  "headerList": [
    {
      "type": "sort",
      "position": "left",
      "label": "Master Code",
      "name": "masterCode"
    },
    {
      "type": "sort",
      "position": "left",
      "label": "Description",
      "name": "descr"
    },
    {
      "type": "sort",
      "position": "left",
      "label": "Sequence No",
      "name": "seqNo"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "Active",
      "name": "isActive"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "System",
      "name": "isSystem"
    },
    {
      "type": "label",
      "position": "center",
      "label": "Action"
    }
  ],
  "bodyList": [
    {
      "type": "text",
      "position": "left",
      "property": "masterCode"
    },
    {
      "type": "text",
      "position": "left",
      "property": "descr"
    },
    {
      "type": "text",
      "position": "left",
      "property": "seqNo"
    },
    {
      "type": "boolean",
      "position": "center",
      "property": "isActive"
    },
    {
      "type": "boolean",
      "position": "center",
      "property": "isSystem"
    },
    {
      "type": "action",
      "position": "center",
      "action": [
        {
          "type": "switch",
          "case": [
            {
              "conditions": [
                {
                  "property": "isSystem",
                  "value": "0",
                  "restriction": "EQ"
                }
              ],
              "result": {
                "type": "url",
                "path": "/CommonSetting/Master/detail",
                "param": [
                  {
                    "type": "refMasterId",
                    "property": "refMasterId"
                  },
                  {
                    "type":"mode",
                    "property":"edit"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "switch",
          "case": [
            {
              "conditions": [
                {
                  "property": "isSystem",
                  "value": "0",
                  "restriction": "EQ"
                }
              ],
              "result": {
                "type": "delete",
                "param": [
                  {
                    "type": "refMasterId",
                    "property": "refMasterId"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
