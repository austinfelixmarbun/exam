    {
      "type": "boolean",
      "position": "center",
      "property": "IsSystem"
    },
    {
      "type": "action",
      "position": "center",
      "action": [
        {
          "type": "switch",
          "case": [
            {
              "conditions": [
                {
                  "property": "IsSystem",
                  "value": "0",
                  "restriction": "EQ"
                }
              ],
              "result": {
                "type": "url",
                "path": "/CommonSetting/Master/Detail",
                "param": [
                  {
                    "type": "RefMasterId",
                    "property": "RefMasterId"
                  },
                  {
                    "type":"mode",
                    "property":"edit"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "switch",
          "case": [
            {
              "conditions": [
                {
                  "property": "IsSystem",
                  "value": "0",
                  "restriction": "EQ"
                }
              ],
              "result": {
                "type": "delete",
                "property": "RefMasterId"
              }
            }
          ]
        }
      ]
    }
  ]
