  "querystring": {
    "select": "SELECT UMH.UPLOAD_MONITORING_NO AS UploadNo, UMH.OFFICE_CODE AS OfficeCode, RO.OFFICE_NAME AS OfficeName, UMH.FILE_NAME AS FileName, UMH.TOTAL_RECORD AS TotalRecord, UMH.TOTAL_RECORD_PROCESSED AS TotalRecordProcessed, UMH.TOTAL_RECORD_ERROR AS TotalRecordError, RS.DESCR AS UploadStatus,UMH.MR_UPLOAD_STATUS_CODE AS UploadStatusCode ,UMH.ERROR_MESSAGE AS ErrorMessage, UMH.UPLOAD_MONITORING_H_ID AS UploadId",
    "from": "FROM dbo.UPLOAD_MONITORING_H UMH WITH(NOLOCK) JOIN dbo.UPLOAD_TYPE UT WITH(NOLOCK) ON UT.UPLOAD_TYPE_ID = UMH.UPLOAD_TYPE_ID JOIN dbo.REF_STATUS RS WITH(NOLOCK) ON RS.REF_STATUS_CODE = UMH.MR_UPLOAD_STATUS_CODE JOIN dbo.REF_OFFICE RO ON RO.OFFICE_CODE = UMH.OFFICE_CODE",
    "where": "WHERE UT.UPLOAD_TYPE_CODE = 'UPL_ASM' AND RS.STATUS_GRP_CODE = 'UPLOAD_STATUS'"
  },
