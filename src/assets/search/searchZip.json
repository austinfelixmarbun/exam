  "querystring": {
    "select": "SELECT A.REF_ZIPCODE_ID AS refZipcodeId, A.AREA_CODE_1 AS areaCode1, A.AREA_CODE_2 AS areaCode2, A.CITY AS city, A.ZIPCODE AS zipcode, A.REF_PROV_DISTRICT_ID as refProvDistrictId, A.SUB_ZIPCODE AS subZipcode, B.PROV_DISTRICT_NAME as provDistrictName",
    "from": "FROM REF_ZIPCODE A WITH(NOLOCK) LEFT JOIN REF_PROV_DISTRICT B WITH(NOLOCK) ON A.REF_PROV_DISTRICT_ID=B.REF_PROV_DISTRICT_ID"
  },

