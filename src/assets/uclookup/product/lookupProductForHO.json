{
    "sectionTitle": "Search Product",
    "exportExcel": false,
    "component": [
      {
        "type": "textbox",
        "name": "P.PROD_CODE",
        "id": "ProdCodeId",
        "value": "",
        "label": "Product Code",
        "placeholder": "Placeholder"
      },
      {
        "type": "textbox",
        "name": "P.PROD_NAME",
        "id": "ProdNameId",
        "value": "",
        "label": "Product Name",
        "placeholder": "Placeholder"
      }
    ],
    "querystring": {
        "select": "SELECT P.PROD_CODE AS ProdCode, P.PROD_NAME AS ProdName, PH.PROD_H_ID AS CurrentProdHId",
        "from": "FROM PROD P WITH(NOLOCK) JOIN PROD_H PH WITH(NOLOCK) on P.CURRENT_PROD_H_ID = PH.PROD_H_ID",
        "where" : "WHERE P.PROD_STAT = N'ACT'"
    },
        "headerList": [
        {
            "type": "sort",
            "position": "left",
            "label": "Prod Code",
            "name": "ProdCode"
        },
        {
            "type": "sort",
            "position": "left",
            "label": "Prod Name",
            "name": "ProdName"
        },
        {
            "type": "sort",
            "position": "center",
            "label": "Action",
            "name": "Action"
        }
    ],
    "bodyList": [
        {
            "type": "text",
            "position": "left",
            "property": "ProdCode"
        },
        {
            "type": "text",
            "position": "left",
            "property": "ProdName"
        },
        {
            "type": "action",
            "position": "center",
            "action": [
                {
                    "type": "select",
                    "property": "ProdName"
                }
            ]
        }
    ],
    "propertyId": "ProdName", 
    "propertyName": "ProdName" 
}
