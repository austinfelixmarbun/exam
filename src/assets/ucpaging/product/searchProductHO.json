      }
    ],
    "querystring": {
      "select": "SELECT A.PROD_CODE AS ProdCode, A.PROD_NAME AS ProdName, B.PROD_VERSION AS CurrentProdHId, C.PROD_VERSION AS DraftProdHId, A.END_DT AS EndDt, A.PROD_STAT AS ProdStat, A.PROD_ID AS ProdId, A.DRAFT_PROD_H_ID AS ProdHId",
      "from": "FROM dbo.PROD A WITH(NOLOCK) LEFT JOIN dbo.PROD_H B WITH(NOLOCK) ON A.CURRENT_PROD_H_ID=B.PROD_H_ID LEFT JOIN dbo.PROD_H C WITH(NOLOCK) ON A.DRAFT_PROD_H_ID=C.PROD_H_ID"
    },
    "bodyList": [
      {
        "type": "text",
        "position": "center",
        "property": "ProdCode"
      },
      {
        "type": "text",
        "position": "center",
