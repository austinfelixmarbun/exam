{
  "title": "Product HO",
  "exportExcel": false,
  "component": [{
      "type": "textbox",
      "name": "Prod_Code",
      "id": "ProdCodeId",
      "value": "",
      "label": "PRODUCT CODE",
      "placeholder": "Placeholder"
    },
    {
      "type": "textbox",
      "name": "Prod_Name",
      "id": "ProdNameId",
      "value": "",
      "label": "PRODUCT NAME",
      "placeholder": "Placeholder"
    },
    {
      "type": "dropdown",
      "name": "A.Prod_Stat",
      "id": "ProdStatId",
      "value": "PRODUCT STATUS",
      "placeholder": "Placeholder",
      "isFromURL": true,
      "isSelectOne": false,
      "url": "http://r3app-server.ad-ins.com/FOUNDATION_R3/RefMaster/GetListKeyValueActiveByCode",
      "label": "Product Status",
      "items": [],
      "itemsUrl": [],
      "criteriaPropName": "RefMasterTypeCode",
      "criteriaPropValue": "PRODUCT_STAT"
    },
    {
      "type": "datepicker",
      "name": "End_Dt",
      "id": "EndDtId",
      "value": "",
      "label": "END DATE",
      "placeholder": "Placeholder"
    }
  ],
  "headerList": [{
      "type": "sort",
      "position": "center",
      "label": "Product Code",
      "name": "ProdCode"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "Product Name",
      "name": "ProdName"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "Current Version",
      "name": "CurrentProdVersion"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "Draft Version",
      "name": "DraftProdVersion"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "End Date",
      "name": "EndDt"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "Product Status",
      "name": "ProdStat"
    },
    {
      "type": "label",
      "position": "center",
      "label": "Action"
    }
  ],
  "querystring": {
    "select": "SELECT A.PROD_CODE AS ProdCode, A.PROD_NAME AS ProdName, B.PROD_VERSION AS CurrentProdVersion, C.PROD_VERSION AS DraftProdVersion, A.END_DT AS EndDt, A.PROD_STAT AS ProdStat, A.PROD_ID AS ProdId, A.DRAFT_PROD_H_ID AS DraftProdHId, A.CURRENT_PROD_H_ID AS CurrentProdHId",
    "from": "FROM dbo.PROD A WITH(NOLOCK) LEFT JOIN dbo.PROD_H B WITH(NOLOCK) ON A.CURRENT_PROD_H_ID=B.PROD_H_ID LEFT JOIN dbo.PROD_H C WITH(NOLOCK) ON A.DRAFT_PROD_H_ID=C.PROD_H_ID"
  },
  "bodyList": [{
      "type": "text",
      "position": "center",
      "property": "ProdCode"
    },
    {
      "type": "text",
      "position": "center",
      "property": "ProdName"
    },
    {
      "type": "text",
      "position": "center",
      "property": "CurrentProdVersion"
    },
    {
      "type": "text",
      "position": "center",
      "property": "DraftProdVersion"
    },
    {
      "type": "date",
      "position": "center",
      "property": "EndDt"
    },
    {
      "type": "text",
      "position": "center",
      "property": "ProdStat"
    },
    {

      "type": "action",
      "position": "center",
      "action": [{
        "type": "switch",
        "case": [{
          "conditions": [{
            "property": "ProdStat",
            "value": "DEACT",
            "restriction": "NEQ"
          }],
          "result": {
            "type": "callback",
            "key": "EditProductOffering"
          }
        }]
      }]
    }
  ]
}