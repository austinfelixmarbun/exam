    "querystring": {
      "select": "SELECT A.REQUEST_DATE AS ReqDt, C.PROD_CODE AS ProdCode, C.PROD_NAME AS ProdName, D.PROD_VERSION AS CurrentVersion, B.PROD_VERSION AS DraftVersion, B.START_DT AS StartDt, B.END_DT AS EndDt,C.PROD_ID AS ProdId, B.PROD_H_ID AS ProdHId, A.STATUS AS ReqType, A.APV_NO AS ApvNo, A.REQUEST_BY AS ReqBy, A.MAIN_USERNAME AS TaskOwner, A.USERNAME AS CurrentUser",
      "from": "FROM dbo.APPROVAL_TASK_MAPPER A WITH(NOLOCK) JOIN dbo.PROD_H B WITH(NOLOCK) ON A.TRX_NO = B.PROD_H_ID JOIN dbo.PROD C WITH(NOLOCK) ON B.PROD_ID = C.PROD_ID LEFT JOIN dbo.PROD_H D WITH(NOLOCK) ON C.CURRENT_PROD_H_ID = D.PROD_H_ID"
    },
