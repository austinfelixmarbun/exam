  "querystring": {
    "select": "SELECT P.PROD_CODE as ProdCode, P.PROD_NAME as ProdName,A.PROD_OFFERING_CODE as ProdOfferingCode, A.PROD_OFFERING_NAME as ProdOfferingName,A.CURRENT_PROD_OFFERING_H_ID AS CurrentProdOfferingHId , A.DRAFT_PROD_OFFERING_H_ID AS DraftProdOfferingHId, A.END_DT AS EndDt, A.PROD_OFFERING_STAT AS ProdOfferingStat, C.PROD_OFFERING_VERSION AS CurrentProdOfrVersion, D.PROD_OFFERING_VERSION AS DraftProdOfrVersion",
    "from": "FROM PROD_OFFERING A WITH(NOLOCK) LEFT JOIN PROD_OFFERING_H B WITH(NOLOCK) ON A.CURRENT_PROD_OFFERING_H_ID = B.PROD_OFFERING_H_ID JOIN PROD P WITH(NOLOCK) ON A.PROD_ID = P.PROD_ID LEFT JOIN PROD_OFFERING_H D ON A.DRAFT_PROD_OFFERING_H_ID = D.PROD_OFFERING_H_ID LEFT JOIN PROD_OFFERING_H C WITH(NOLOCK) ON A.CURRENT_PROD_OFFERING_H_ID = C.PROD_OFFERING_H_ID"
  },
