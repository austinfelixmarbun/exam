    "querystring": {
      "select": "SELECT C.PROD_OFFERING_CODE AS ProdOfferingCode, C.PROD_OFFERING_NAME AS ProdOfferingName, B.REQUEST_DT AS RequestDt, D.PROD_OFFERING_VERSION AS CurrentVersion, B.PROD_OFFERING_VERSION AS DraftVersion, B.START_DT AS StartDt, B.END_DT AS EndDt,C.PROD_OFFERING_ID AS ProdOfferingId, B.PROD_OFFERING_H_ID AS ProdOfferingHId",
      "from": "FROM dbo.APPROVAL_TASK_MAPPER A WITH(NOLOCK) JOIN dbo.PROD_OFFERING_H B WITH(NOLOCK) ON A.TRX_NO = B.PROD_OFFERING_H_ID JOIN dbo.PROD_OFFERING C WITH(NOLOCK) ON B.PROD_OFFERING_ID = C.PROD_OFFERING_ID LEFT JOIN PROD_OFFERING_H D WITH(NOLOCK) ON C.CURRENT_PROD_OFFERING_H_ID = D.PROD_OFFERING_H_ID"
    },
    "bodyList": [
      {
        "type": "text",
        "position": "center",
        "property": "ProdOfferingCode"
      },
      {
        "type": "text",
        "position": "center",
