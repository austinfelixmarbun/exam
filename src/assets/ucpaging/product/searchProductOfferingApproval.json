    "querystring": {
      "select": "SELECT A.REQUEST_DATE AS ReqDt, C.PROD_OFFERING_CODE AS ProdOfferingCode, C.PROD_OFFERING_NAME AS ProdOfferingName, D.PROD_OFFERING_VERSION AS CurrentVersion, B.PROD_OFFERING_VERSION AS DraftVersion, B.START_DT AS StartDt, B.END_DT AS EndDt,C.PROD_OFFERING_ID AS ProdOfferingId, B.PROD_OFFERING_H_ID AS ProdOfferingHId, A.STATUS AS ReqType, A.APV_NO AS ApvNo, A.REQUEST_BY AS ReqBy, A.MAIN_USERNAME AS TaskOwner, A.USERNAME AS CurrentUser",
      "from": "FROM dbo.APPROVAL_TASK_MAPPER A WITH(NOLOCK) JOIN dbo.PROD_OFFERING_H B WITH(NOLOCK) ON A.TRX_NO = B.PROD_OFFERING_H_ID JOIN dbo.PROD_OFFERING C WITH(NOLOCK) ON B.PROD_OFFERING_ID = C.PROD_OFFERING_ID LEFT JOIN PROD_OFFERING_H D WITH(NOLOCK) ON C.CURRENT_PROD_OFFERING_H_ID = D.PROD_OFFERING_H_ID"
    },
