{
  "title": "Product Offering Summary",
  "exportExcel": false,
  "component": [
    {
      "type": "textbox",
      "name": "B.PROD_OFFERING_CODE",
      "id": "prodCodeId",
      "value": "",
      "label": "Product Code",
      "placeholder": "Placeholder"
    }

  ],
  "headerList": [
    {
      "type": "sort",
      "position": "center",
      "label": "Product Offering Code",
      "name": "prodOfferingCode"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "Product Offering Name",
      "name": "prodOfferingName"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "Current Version",
      "name": "currentProdOfferingVersion"
    },
    {
      "type": "sort",
      "position": "center",
      "label": "End Date",
      "name": "endDt"
    }
  ],
  "querystring": {
    "select": "SELECT B.PROD_OFFERING_CODE as prodOfferingCode, B.PROD_OFFERING_NAME as prodOfferingName, C.PROD_OFFERING_VERSION AS currentProdOfferingVersion , B.END_DT AS endDt, B.PROD_OFFERING_STAT AS ProdOfferingStat",
    "from": "FROM dbo.PROD A WITH(NOLOCK) LEFT JOIN dbo.PROD_OFFERING B WITH(NOLOCK) ON A.PROD_ID=B.PROD_ID LEFT JOIN dbo.PROD_OFFERING_H C WITH(NOLOCK) ON B.CURRENT_PROD_OFFERING_H_ID = C.PROD_OFFERING_H_ID"
  },
  "bodyList": [
    {
      "type": "text",
      "position": "center",
      "property": "prodOfferingCode"
    },
    {
      "type": "text",
      "position": "center",
      "property": "prodOfferingName"
    },
    {
      "type": "text",
      "position": "center",
      "property": "currentProdOfferingVersion"
    },
    {
      "type": "date",
      "position": "center",
      "property": "endDt"
    }


  ]
}
