  "querystring": {
    "select": "SELECT B.ASSET_DOC_CODE as AssetDocCode,B.ASSET_DOC_NAME as AssetDocName, A.ASSET_DOC_LIST_ID as AssetDocListId, B.REF_ASSET_DOC_ID as RefAssetDocId, A.ASSET_TYPE_ID AS AssetTypeId,   A.IS_MAIN_DOC as IsMainDoc, A.IS_VALUE_NEEDED as IsValueNeeded, A.IS_PLEDGE as IsPledge, A.IS_BORROW as IsBorrow, A.IS_MANDATORY_NEW as IsMandatoryNew, IS_MANDATORY_USED as IsMandatoryUsed, A.IS_ACTIVE as IsActive",
    "from": "FROM dbo.ASSET_DOC_LIST A WITH(NOLOCK) JOIN dbo.REF_ASSET_DOC B WITH(NOLOCK) ON A.REF_ASSET_DOC_ID = B.REF_ASSET_DOC_ID "
 
  },
