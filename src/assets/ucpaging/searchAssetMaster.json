  "querystring": {
    "select": "SELECT A.FULL_ASSET_CODE as FullAssetCode,A.ASSET_MASTER_ID as AssetMasterId,A.FULL_ASSET_NAME as FullAssetName,A.HIERARCHY_LVL as HierarchyLvl,A.IS_FINAL as IsFinal,A.IS_ACTIVE as IsActive,B.ASSET_TYPE_ID as AssetTypeId,B.ASSET_TYPE_CODE as AssetTypeCode,B.ASSET_TYPE_NAME as AssetTypeName,C.ASSET_CATEGORY_NAME as AssetCategoryName",
    "from": "FROM dbo.ASSET_MASTER A WITH(NOLOCK) LEFT JOIN dbo.ASSET_TYPE B WITH(NOLOCK) ON B.ASSET_TYPE_ID = A.ASSET_TYPE_ID LEFT JOIN dbo.ASSET_CATEGORY C WITH(NOLOCK) ON C.ASSET_CATEGORY_ID = A.ASSET_CATEGORY_ID"
  },
