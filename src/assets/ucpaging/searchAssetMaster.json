                  "type": "edit",
                  "path": "/Asset/AssetMaster/Child",
                  "param": [
                    {
                      "type": "AssetMasterId",
                      "property": "AssetMasterId"
                    },
                    {
                      "type": "AssetTypeId",
                      "property": "AssetTypeId"
                    },
                    {
