                    },
                    {
                      "type": "HierarchyLvl",
                      "property": "HierarchyLvl"
                    },
                    {
                      "type": "FullAssetCode",
                      "property": "FullAssetCode"
                    },
                    {
                      "type": "FullAssetName",
                      "property": "FullAssetName"
                    }
                  ]
                }
              }
          ]
        }
      ]
    },
    {
      "type": "action",
      "position": "center",
      "action": [
        {
          "type" : "switch", 
          "case" : [ 
            {
              "conditions" : [ 
                {
                  "property" : "HierarchyLvl", 
                  "value" : "1"
                }
              ],
                "result" : 
                {
                  "path" : "/Asset/AssetMaster/Detail",
                  "param" : [
                    {
                      "type": "AssetMasterId",
                      "property": "AssetMasterId"
                    },
                    {
                      "type": "param",
                      "property": "edit"
                    }
                  ]
                }
