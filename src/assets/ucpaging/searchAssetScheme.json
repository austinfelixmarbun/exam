    "querystring": {
      "select": "SELECT ASH.ASSET_SCHM_H_ID AS AssetSchmHId, ASH.ASSET_SCHM_NAME AS AssetSchmName, ASH.ASSET_SCHM_CODE AS AssetSchmCode, ATH.ASSET_TYPE_ID AS AssetTypeHId, ATH.ASSET_TYPE_NAME AS AssetTypeName, COUNT(ASD.ASSET_SCHM_D_ID) AS NumOfAsset, ASH.IS_ACTIVE AS IsActive",
      "from": "FROM dbo.ASSET_SCHM_H ASH WITH(NOLOCK) JOIN dbo.ASSET_TYPE ATH WITH(NOLOCK) ON ATH.ASSET_TYPE_ID = ASH.ASSET_TYPE_ID LEFT JOIN dbo.ASSET_SCHM_D ASD WITH(NOLOCK) ON ASD.ASSET_SCHM_H_ID = ASH.ASSET_SCHM_H_ID GROUP BY ASH.ASSET_SCHM_H_ID,ASH.ASSET_SCHM_NAME,ASH.ASSET_SCHM_CODE,ATH.ASSET_TYPE_ID,ATH.ASSET_TYPE_NAME,ASH.IS_ACTIVE"
    },
