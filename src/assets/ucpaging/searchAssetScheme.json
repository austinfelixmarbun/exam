    },
    {
      "type": "label",
      "position": "center",
      "label": "Edit"
    }
  ],
  "querystring": {
    "select": "SELECT ASH.ASSET_SCHM_CODE AS AssetSchmCode, ASH.ASSET_SCHM_H_ID AS AssetSchmHId, ASH.ASSET_SCHM_NAME AS AssetSchmName, ATH.ASSET_TYPE_ID AS AssetTypeId, ATH.ASSET_TYPE_NAME AS AssetTypeName, COUNT(ASD.ASSET_SCHM_D_ID) AS NumOfAsset, ASH.IS_ACTIVE AS IsActive, ASH.IS_SYSTEM AS IsSystem",
    "from": "FROM dbo.ASSET_SCHM_H ASH WITH(NOLOCK) JOIN dbo.ASSET_TYPE ATH WITH(NOLOCK) ON ATH.ASSET_TYPE_ID = ASH.ASSET_TYPE_ID LEFT JOIN dbo.ASSET_SCHM_D ASD WITH(NOLOCK) ON ASD.ASSET_SCHM_H_ID = ASH.ASSET_SCHM_H_ID",
    "groupby" : "GROUP BY ASH.ASSET_SCHM_H_ID,ASH.ASSET_SCHM_NAME,ASH.ASSET_SCHM_CODE,ATH.ASSET_TYPE_ID,ATH.ASSET_TYPE_NAME,ASH.IS_ACTIVE,ASH.IS_SYSTEM"
  },
  "bodyList": [
    {
      "type": "text",
      "position": "left",
      "property": "AssetSchmCode"
    },
    {
      "type": "text",
      "position": "left",
      "property": "AssetSchmName"
    },
    {
      "type": "text",
      "position": "left",
      "property": "AssetTypeName"
    },
    {
      "type": "text",
      "position": "right",
      "property": "NumOfAsset"
    },
    {
      "type": "boolean",
      "position": "center",
      "property": "IsActive"
    },
    {
      "type": "action",
      "position": "center",
      "action": [
        {
          "type": "edit",
          "path": "/Asset/Scheme/MemberDetail",
          "param": [
            {
              "type": "AssetSchmHId",
              "property": "AssetSchmHId"
            }
          ]
        }
      ]
    },
    {
      "type": "action",
      "position": "center",
      "action": [
        {
          "type" : "switch", 
          "case" : [ 
            {
              "conditions" : [ 
                {
                  "property" : "IsSystem", 
                  "value" : "0",
                  "restriction": "EQ"
                }
              ],
              "result" : 
              {
                "type": "url",
                "path": "/Asset/Scheme/InformationDetail",
                "param": [
                  {
                    "type": "AssetSchmHId",
                    "property": "AssetSchmHId"
                  },
                  {
                    "type": "param",
                    "property": "edit"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}