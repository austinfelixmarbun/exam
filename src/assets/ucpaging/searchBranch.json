    "querystring": {
        "select": "SELECT vdr.MR_VENDOR_CLASS AS MrVendorClass, vdr.VENDOR_ID AS VendorId, vdr.MR_VENDOR_CATEGORY_CODE AS MrVendorCategoryCode, VENDOR_CODE AS BranchCode, VENDOR_NAME AS BranchName, ADDR AS BranchAddress, VENDOR_RATING AS BranchRating, IS_ACTIVE AS IsActive",
        "from": "FROM dbo.VENDOR vdr WITH(NOLOCK) LEFT JOIN dbo.VENDOR_ADDR vaddr WITH(NOLOCK) on vdr.VENDOR_ID = vaddr.VENDOR_ID"
    },
