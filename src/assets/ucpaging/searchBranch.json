                                }
                            ],
                            "result": {
                                "path": "/Vendor/Branch",
                                "param": [
                                    {
                                        "type": "MrVendorCategoryCode",
                                        "property": "MrVendorCategoryCode"
                                    }
                                ]
                            },
                            "isHide": false
