    "querystring": {
        "select": "SELECT RU.USERNAME AS Username, RE.EMP_NAME AS EmpName, RE.EMP_NO AS EmpNo, RJT.JOB_TITLE_CODE, RJT.JOB_TITLE_NAME AS JobTitleName, RO.OFFICE_CODE, RO.OFFICE_NAME AS OfficeName, SPVEMP.EMP_NAME AS SpvName, RUR.IS_ACTIVE AS IsActive, RUR.REF_BIZ_UNIT_ID AS RefBizUnitId, RUR.SPV_ID AS SpvId",
        "from": "FROM DBO.REF_USER RU WITH(NOLOCK) JOIN DBO.REF_EMP RE ON RU.REF_EMP_ID = RE.REF_EMP_ID JOIN REF_USER_ROLE RUR WITH(NOLOCK) ON RUR.REF_USER_ID = RU.REF_USER_ID LEFT JOIN DBO.REF_JOB_TITLE RJT WITH(NOLOCK) ON RUR.REF_JOB_TITLE_ID = RJT.REF_JOB_TITLE_ID JOIN DBO.REF_OFFICE RO WITH(NOLOCK) ON RO.REF_OFFICE_ID = RUR.REF_OFFICE_ID LEFT JOIN REF_USER SPVRU WITH(NOLOCK) ON SPVRU.REF_USER_ID = RUR.SPV_ID LEFT JOIN REF_EMP SPVEMP WITH(NOLOCK) ON SPVEMP.REF_EMP_ID = SPVRU.REF_EMP_ID"
    },
