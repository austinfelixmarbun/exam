    "querystring": {
        "select": "SELECT B.USERNAME AS Username, A.SPV_ID AS Supervisor, A.IS_ACTIVE AS IsActive, C.EMP_NAME AS EmpName, C.EMP_NO AS EmpNo, D.JOB_TITLE_NAME AS JobTitleName, A.REF_OFFICE_ID AS OfficeId, E.OFFICE_NAME AS OfficeName, A.REF_BIZ_UNIT_ID AS RefBizUnitId",
        "from": "FROM dbo.REF_USER_ROLE A WITH(NOLOCK) JOIN dbo.REF_USER B WITH(NOLOCK) ON B.REF_USER_ID = A.REF_USER_ID JOIN dbo.REF_EMP C WITH(NOLOCK) ON C.REF_EMP_ID = B.REF_EMP_ID JOIN dbo.REF_JOB_TITLE D WITH(NOLOCK) ON D.REF_JOB_TITLE_ID = A.REF_JOB_TITLE_ID JOIN dbo.REF_OFFICE E WITH(NOLOCK) ON E.REF_OFFICE_ID = A.REF_OFFICE_ID LEFT JOIN dbo.REF_USER_ROLE F WITH(NOLOCK) ON F.REF_USER_ID = A.SPV_ID"
    },
