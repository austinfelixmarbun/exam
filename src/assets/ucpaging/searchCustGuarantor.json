            "property": "MrCustTypeCode"
        },
        {
            "type": "action",
            "position": "center",
            "action": [
                {
                    "type": "switch",
                    "case": [
                        {
                            "conditions": [
                                {
                                    "property": "MrCustTypeCode",
                                    "value": "PERSONAL",
                                    "restriction": "EQ"
                                }
                            ],
                            "result": {
                                "type": "link",
                                "position": "left",
                                "property": "CustNo",
                                "path": "/View/Customer/PersonalDetail",
                                "target": "_blank",
                                "param": [
                                    {
                                        "type": "CustId",
                                        "property": "CustId"
                                    }
                                ]
                            },
                            "isHide": false
                        },
                        {
                            "conditions": [
                                {
                                    "property": "MrCustTypeCode",
                                    "value": "COMPANY",
                                    "restriction": "EQ"
                                }
                            ],
                            "result": {
                                "type": "link",
                                "position": "left",
                                "property": "CustNo",
                                "path": "/View/Customer/CoyDetail",
                                "target": "_blank",
                                "param": [
                                    {
                                        "type": "CustId",
                                        "property": "CustId"
                                    }
                                ]
                            },
                            "isHide": false
                        }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "position": "left",
            "property": "CustName"
        },
        {
            "type": "text",
            "position": "left",
            "property": "IdNo"
        },
        {
            "type": "action",
            "position": "center",
            "action": [
                {
                    "type": "switch",
                    "case": [
                        {
                            "conditions": [
                                {
                                    "property": "MrCustTypeCode",
                                    "value": "PERSONAL",
                                    "restriction": "EQ"
                                }
                            ],
                            "result": {
                                "type": "url",
                                "path": "/Customer/CustomerPersonal/Page",
                                "icon": "ft-edit-2",
                                "param": [
                                    {
                                        "type": "IdCust",
                                        "property": "CustId"
                                    },
                                    {
                                        "type": "From",
                                        "property": "CustGuarantor"
                                    }
                                ]
                            },
                            "isHide": false
                        },
                        {
                            "conditions": [
                                {
                                    "property": "MrCustTypeCode",
                                    "value": "COMPANY",
                                    "restriction": "EQ"
                                }
                            ],
                            "result": {
                                "type": "url",
                                "path": "/Customer/CustomerCompany/Page",
                                "icon": "ft-edit-2",
                                "param": [
                                    {
                                        "type": "IdCust",
                                        "property": "CustId"
                                    },
                                    {
                                        "type": "From",
                                        "property": "CustGuarantor"
                                    }
                                ]
                            },
                            "isHide": false
                        }
                    ]
                }
            ]
        }
    ]
