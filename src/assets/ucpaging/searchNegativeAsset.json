    "querystring": { 
        "select": "SELECT ATH.ASSET_TYPE_NAME AS assetTypeName, B.FULL_ASSET_CODE AS fullAssetCode, B.FULL_ASSET_NAME AS fullAssetName, A.SERIAL_NO_1 AS serialNo1, A.SERIAL_NO_2 AS serialNo2, A.SERIAL_NO_3 AS serialNo3, A.SERIAL_NO_4 AS serialNo4, A.SERIAL_NO_5 AS serialNo5, D.DESCR as descr, A.IS_ACTIVE AS isActive, A.ASSET_NEGATIVE_ID AS assetNegativeId", 
        "from": "FROM dbo.ASSET_NEGATIVE AS A WITH(NOLOCK) INNER JOIN dbo.ASSET_MASTER AS B WITH(NOLOCK) ON A.ASSET_MASTER_ID = B.ASSET_MASTER_ID INNER JOIN dbo.ASSET_TYPE AS ATH WITH(NOLOCK) ON B.ASSET_TYPE_ID = ATH.ASSET_TYPE_ID INNER JOIN dbo.REF_MASTER AS D WITH(NOLOCK) ON A.MR_NEG_ASSET_SOURCE_CODE = D.MASTER_CODE AND D.REF_MASTER_TYPE_CODE = 'NEG_ASSET_SOURCE' INNER JOIN dbo.ASSET_CATEGORY AS AC WITH(NOLOCK) ON B.ASSET_CATEGORY_ID = AC.ASSET_CATEGORY_ID"
    },
