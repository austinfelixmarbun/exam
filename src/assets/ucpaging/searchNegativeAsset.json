    "querystring": { 
        "select": "SELECT A.ASSET_NEGATIVE_ID AS assetNegativeId, C.ASSET_TYPE_NAME AS assetTypeName, B.FULL_ASSET_CODE AS fullAssetCode, B.FULL_ASSET_NAME AS fullAssetName, A.SERIAL_NO_1 AS serialNo1, A.SERIAL_NO_2 AS serialNo2, A.SERIAL_NO_3 AS serialNo3, A.SERIAL_NO_4 AS serialNo4, A.SERIAL_NO_5 AS serialNo5, D.DESCR as descr, A.IS_ACTIVE AS isActive",
        "from": "FROM ASSET_NEGATIVE AS A WITH(NOLOCK) INNER JOIN ASSET_MASTER AS B WITH(NOLOCK) ON A.ASSET_MASTER_ID = B.ASSET_MASTER_ID INNER JOIN ASSET_TYPE AS C WITH(NOLOCK) ON B.ASSET_TYPE_ID = C.ASSET_TYPE_ID INNER JOIN REF_MASTER AS D WITH(NOLOCK) ON A.MR_SOURCE_TYPE_CODE = D.MASTER_CODE",
    },
