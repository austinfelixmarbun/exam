    "querystring": { 
        "select": "SELECT NEGATIVE_CUST_ID AS negativeCustId, CUST_NO AS custNo, CUST_NAME AS custName, MR_CUST_TYPE_CODE AS mrCustTypeCode, ID_NO AS idNo, B.DESCR AS negCustSource, C.DESCR AS negCustType, A.IS_ACTIVE AS isActive",
        "from": "FROM NEGATIVE_CUST AS A WITH(NOLOCK) INNER JOIN REF_MASTER AS B WITH(NOLOCK) ON A.MR_NEG_CUST_SOURCE_CODE = B.MASTER_CODE INNER JOIN REF_MASTER AS C WITH(NOLOCK) ON A.MR_NEG_CUST_TYPE_CODE = C.MASTER_CODE"
