{
    "title": "Reason",
    "exportExcel": false,
    "component": [
      {
        "type": "textbox",
        "name": "REASON_CODE",
        "id": "reasonCodeId",
        "value": "",
        "label": "Reason Code",
        "placeholder": "Placeholder",
        "datatype": "text"
      },
      {
        "type": "dropdown",
        "datatype": "text",
        "name": "REF_REASON_TYPE_CODE",
        "id": "reasonTypeNameId",
        "value": "",
        "placeholder": "Placeholder",
        "isFromURL": true,
        "isSelectOne": true,
        "url": "",
        "path": "/RefReasonType/GetListKeyValueByCode",
        "label": "Reason Type Name",
        "items": [],
        "itemsUrl": []
      },
      {
        "type": "textbox",
        "name": "REASON_DESCR",
        "id": "reasonDescrId",
        "value": "",
        "label": "Reason Desciption",
        "placeholder": "Placeholder",
        "datatype": "text"
      },
      {
        "type": "dropdown",
        "name": "is_Active",
        "id": "isActive",
        "value": "Active Status",
        "placeholder": "Placeholder",
        "isFromURL": false,
        "isSelectOne": false,
        "url": "https://api.myjson.com/bins/ld6e8",
        "label": "Active Status",
        "items": [
          {
            "key": "1",
            "value": "Yes"
          },
          {
            "key": "0",
            "value": "No"
          }
        ],
        "itemsUrl": []
      }
    ],
    "querystring": {
      "select": "SELECT A.REASON_CODE as reasonCode, A.REF_REASON_ID as refReasonId, A.REASON_DESCR as reasonDescr, A.IS_ACTIVE as isActive, A.IS_SYSTEM AS isSystem",
      "from": "FROM dbo.REF_REASON A WITH(NOLOCK)"
    },
    "headerList": [
      {
        "type": "sort",
        "position": "left",
        "label": "Reason Code",
        "name": "reasonCode"
      },
      {
        "type": "sort",
        "position": "left",
        "label": "Reason Description",
        "name": "reasonDescr"
      },
      {
        "type": "sort",
        "position": "center",
        "label": "Active Status",
        "name": "isActive"
      },
      {
        "type": "sort",
        "position": "center",
        "label": "System",
        "name": "isSystem"
      },
      {
        "type": "label",
        "position": "center",
        "label": "Action"
      }
    ],
    "bodyList": [
      {
        "type": "text",
        "position": "left",
        "property": "reasonCode"
      },
      {
        "type": "text",
        "position": "left",
        "property": "reasonDescr"
      },
      {
        "type": "boolean",
        "position": "center",
        "property": "isActive"
      },
      {
        "type": "boolean",
        "position": "center",
        "property": "isSystem"
      },
      {
        "type": "action",
        "position": "center",
        "action": [
          {
            "type": "switch",
            "case": [
              {
                "conditions": [
                  {
                    "property": "isSystem",
                    "value": false,
                    "restriction": "EQ"
                  }
                ],
                "result": {
                  "type": "url",
                  "path": "/CommonSetting/Reason/Detail",
                  "icon": "ft-edit-2",
                  "param": [
                    {
                      "type": "refReasonId",
                      "property": "refReasonId"
                    },
                    {
                      "type": "mode",
                      "property": "edit"
                    }
                  ]
                },
                "isHide": false
              }
            ]
          }
        ]
      }
    ]
  }
  