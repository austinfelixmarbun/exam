{
    "title": "Ref Attribute",
    "exportExcel": false,
    "component": [
        {
            "type": "textbox",
            "name": "ATTR_CODE",
            "id": "AttrCode",
            "value": "",
            "label": "Attribute Code",
            "placeholder": "Placeholder"
        },
        {
            "type": "textbox",
            "name": "ATTR_NAME",
            "id": "AttrName",
            "value": "",
            "label": "Attribute Name",
            "placeholder": "Placeholder"
        },
        {
            "type": "textbox",
            "name": "ATTR_GROUP",
            "id": "AttrGroup",
            "value": "",
            "label": "Attribute Group",
            "placeholder": "Placeholder"
        },
        {
            "type": "dropdown",
            "name": "IS_ACTIVE",
            "id": "IsActive",
            "value": "",
            "placeholder": "Placeholder",
            "isFromURL": false,
            "isSelectOne" : false,
            "url": "",
            "label": "Active Status",
            "items": [
                {
                    "key": "1",
                    "value": "Yes"
                },
                {
                    "key": "0",
                    "value": "No"
                }
            ],
            "itemsUrl": []
        }
    ],
    "querystring": { 
        "select": "SELECT ATTR_CODE AS attrCode, ATTR_NAME AS attrName, ATTR_GROUP AS attrGroup, IS_SYSTEM AS isSystem, IS_ACTIVE AS isActive, REF_ATTR_ID AS refAttrId", 
        "from": "FROM dbo.REF_ATTR WITH(NOLOCK)"
    },
    "headerList" : [ 
        {
            "type" : "sort", 
            "position" : "left", 
            "label" : "Attribute Code",
            "name" : "ATTR_CODE" 
        },
        {
            "type" : "sort", 
            "position" : "left", 
            "label" : "Attribute Name", 
            "name" : "ATTR_NAME" 
        },
        {
            "type" : "sort", 
            "position" : "left", 
            "label" : "Attribute Group", 
            "name" : "ATTR_GROUP" 
        },
        {
            "type" : "sort", 
            "position" : "left", 
            "label" : "Active Status", 
            "name" : "IS_ACTIVE"
        },
        {
            "type" : "label",
            "position" : "center",
            "label" : "Action"
        }
    ],
    "bodyList" : [
        {
            "type" : "text", 
            "position" : "left", 
            "property" : "attrCode" 
        },
        {
            "type" : "text", 
            "position" : "left", 
            "property" : "attrName" 
        },
        {
            "type" : "text", 
            "position" : "left", 
            "property" : "attrGroup" 
        },
        {
            "type" : "boolean", 
            "position" : "left", 
            "property" : "isActive" 
        },
        {
            "type": "action",
            "position": "center",
            "action": [
              {
                "type": "switch",
                "case": [
                  {
                    "conditions": [
                      {
                        "property": "isSystem",
                        "value": "0",
                        "restriction": "EQ"
                      }
                    ],
                    "result": {
                      "type": "url",
                      "path": "/Asset/RefAttr/Detail",
                      "param": [
                        {
                          "type": "refAttrId",
                          "property": "refAttrId"
                        },
                        {
                          "type":"mode",
                          "property":"edit"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
        }
    ]
}