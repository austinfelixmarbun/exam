{
    "title": "Ref Form Role",
    "component": [
        {
            "type": "textbox",
            "name": "RF.FORM_CODE",
            "id": "FormCodeId",
            "value": "",
            "label": "Form Code",
            "placeholder": "FormCode"
        },
        {
            "type": "textbox",
            "name": "RF.TITLE",
            "id": "TitleId",
            "value": "",
            "label": "Title",
            "placeholder": "Title"
        }
    ],
    "querystring": {
        "select": "SELECT RF.FORM_CODE AS FormCode, RF.TITLE AS Title, AF.AUTH_FORM_ID AS AuthFormId, RR.REF_ROLE_ID AS RefRoleId",
        "from": "FROM DBO.AUTH_FORM AF WITH(NOLOCK) JOIN DBO.REF_FORM RF WITH(NOLOCK) ON AF.REF_FORM_ID = RF.REF_FORM_ID JOIN DBO.REF_ROLE RR WITH(NOLOCK) ON AF.REF_ROLE_ID = RR.REF_ROLE_ID"
    },
    "headerList": [
        {
            "type": "sort",
            "position": "center",
            "label": "Form Code",
            "name": "RF.FORM_CODE"
        },
        {
            "type": "sort",
            "position": "center",
            "label": "Title",
            "name": "RF.TITLE"
        },
        {
          "type": "label",
          "position": "center",
          "label": "Action"
        }
    ],
    "bodyList": [
        {
            "type": "text",
            "position": "center",
            "property": "FormCode"
        },
        {
            "type": "text",
            "position": "center",
            "property": "Title"
        },
        {
          "type": "action",
          "position": "center",
