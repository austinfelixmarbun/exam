    "querystring": {
        "select": "SELECT RE.OFFICE_NAME AS OfficeName, SO.TRX_REF_NO AS TrxRefNo, SO.SRVY_ORDER_NO AS SrvyOrderNo, SO.MR_SRVY_STAT_CODE AS MrSrvyStatCode, SO.MR_SRVY_SOURCE_CODE AS MrSrvySourceCode, SO.REQ_BY_USER AS ReqByUser, SO.NOTES AS Notes, SO.REQ_DT AS ReqDt, COUNT(ST.SRVY_TASK_ID) AS TaskTotal, SO.SRVY_ORDER_ID AS SrvyOrderId",
        "from": "FROM dbo.SRVY_ORDER SO WITH(NOLOCK) JOIN dbo.REF_OFFICE RE WITH(NOLOCK) ON RE.REF_OFFICE_ID = SO.REF_OFFICE_ID LEFT JOIN dbo.SRVY_TASK ST WITH(NOLOCK) ON ST.SRVY_ORDER_ID = SO.SRVY_ORDER_ID",
        "groupby": "GROUP BY SO.SRVY_ORDER_ID, RE.OFFICE_NAME, SO.TRX_REF_NO, SO.SRVY_ORDER_NO, SO.MR_SRVY_STAT_CODE, SO.MR_SRVY_SOURCE_CODE, SO.REQ_BY_USER, SO.NOTES, SO.REQ_DT, SO.TASK_TOTAL"
    },
    "headerList": [
