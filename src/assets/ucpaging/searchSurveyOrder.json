                        },
                        {
                            "conditions": [
                                {
                                    "property": "MrSrvyStatCode",
                                    "value": "DONE",
                                    "restriction": "NEQ"
                                }
                            ],
                            "result" : {
                                "type": "url",
                                "path" : "/Survey/Task",
                                "param" : [
