    "querystring": {
        "select": "SELECT A.OFFICE_CODE AS OfficeCode, A.OFFICE_NAME AS OfficeName, A.OFFICE_ADDR AS OfficeAddr , B.OFFICE_NAME AS OfficeParent, A.IS_ACTIVE AS IsActive, A.MR_OFFICE_TYPE_CODE AS MrOfficeTypeCode, A.REF_OFFICE_ID AS RefOfficeId, C.DESCR AS Descr, D.CENTER_GRP_ID AS CenterGrpId",
        "from": "FROM dbo.REF_OFFICE A WITH(NOLOCK) LEFT JOIN dbo.REF_OFFICE B WITH(NOLOCK) ON B.REF_OFFICE_ID = A.PARENT_ID LEFT JOIN dbo.REF_MASTER C WITH(NOLOCK) ON A.MR_OFFICE_TYPE_CODE = C.MASTER_CODE AND C.REF_MASTER_TYPE_CODE = 'OFFICE_TYPE' LEFT JOIN dbo.CENTER_GRP D ON D.CENTER_GRP_CODE = A.OFFICE_CODE"
    }
