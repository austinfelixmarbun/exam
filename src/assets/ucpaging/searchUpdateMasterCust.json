{
    "title": "Update Data Customer",
    "exportExcel": false,
    "component": [
        {
            "type": "textbox",
            "name": "T.APP_NO",
            "id": "AppNoId",
            "value": "",
            "label": "App No.",
            "placeholder": "Placeholder"
        },
        {
            "type": "textbox",
            "name": "O.OFFICE_NAME",
            "id": "OfficeNameId",
            "value": "",
            "label": "Office",
            "placeholder": "Placeholder"
        },
        {
            "type": "textbox",
            "name": "C.CUST_NAME",
            "id": "CustNameId",
            "value": "",
            "label": "Customer Name",
            "placeholder": "Placeholder"
        }
    ],
    "headerList": [
        {
            "type": "sort",
            "position": "left",
            "label": "APP NO",
            "name": "T.APP_NO"
        },
        {
            "type": "sort",
            "position": "left",
            "label": "CUSTOMER NAME",
            "name": "C.CUST_NAME"
        },
        {
            "type": "sort",
            "position": "left",
            "label": "SUBJECT TYPE",
            "name": "T.MR_SUBJECT_TYPE"
        },
        {
            "type": "sort",
            "position": "left",
            "label": "OFFICE",
            "name": "O.OFFICE_NAME"
        },
        {
            "type": "label",
            "position": "center",
            "label": "ACTION"
        }
    ],
    "querystring": {
        "select": "SELECT T.APP_NO AS AppNo, C.CUST_NAME AS CustName, T.MR_SUBJECT_TYPE AS SubjectType, M.DESCR AS SubjectTypeDescr, O.OFFICE_NAME AS OfficeName, T.CUST_DATA_TRX_ID AS CustDataTrxId, T.CUST_NO AS CustNo",
        "from": "FROM TASK_UPD_CUST_DATA AS T WITH(NOLOCK) INNER JOIN CUST AS C WITH(NOLOCK) ON T.CUST_NO = C.CUST_NO INNER JOIN REF_OFFICE AS O WITH(NOLOCK) ON T.REF_OFFICE_ID = O.REF_OFFICE_ID INNER JOIN REF_MASTER AS M WITH(NOLOCK) ON T.MR_SUBJECT_TYPE = M.MASTER_CODE AND M.REF_MASTER_TYPE_CODE = 'UPDATE_MASTER_CUST_SUBJ_TYPE'"
    },
    "bodyList": [
        {
            "type": "text",
            "position": "left",
            "property": "AppNo"
        },
        {
            "type": "text",
            "position": "left",
            "property": "CustName"
        },
        {
            "type": "text",
            "position": "left",
            "property": "SubjectTypeDescr"
        },
        {
            "type": "text",
            "position": "left",
            "property": "OfficeName"
        },
        {
            "type": "action",
            "position": "center",
            "action": [
                {
                    "type": "edit",
                    "path": "/Customer/UpdateDataCustomer/Detail",
                    "param": [
                        {
                            "type": "CustDataTrxId",
                            "property": "CustDataTrxId"
                        },
                        {
                            "type": "CustNo",
                            "property": "CustNo"
                        }
                    ]
                }
            ]
        }
    ]
}