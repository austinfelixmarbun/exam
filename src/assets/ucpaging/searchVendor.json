    "querystring": { 
        "select": "SELECT A.VENDOR_CODE AS VendorCode, A.VENDOR_NAME AS VendorName, A.IS_ACTIVE IsActive, A.VENDOR_ID AS VendorId",
        "from": "FROM dbo.VENDOR A WITH(NOLOCK) LEFT JOIN dbo.VENDOR_GRP_MBR B WITH(NOLOCK) ON A.VENDOR_ID = B.VENDOR_ID LEFT JOIN dbo.VENDOR_GRP C WITH(NOLOCK) ON B.VENDOR_GRP_ID = C.VENDOR_GRP_ID"
    },
