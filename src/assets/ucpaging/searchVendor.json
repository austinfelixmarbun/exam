        "select": "SELECT C.VENDOR_CODE AS VendorCode, C.VENDOR_NAME AS VendorName, C.IS_ACTIVE IsActive, C.VENDOR_ID AS VendorId",
        "from": "FROM dbo.VENDOR_GRP A WITH(NOLOCK) LEFT JOIN dbo.VENDOR_GRP_MBR B WITH(NOLOCK) ON A.VENDOR_GRP_ID = B.VENDOR_GRP_ID LEFT JOIN dbo.VENDOR C WITH(NOLOCK)  ON B.VENDOR_ID = C.VENDOR_ID"
    },
