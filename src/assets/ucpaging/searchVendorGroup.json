    ],
    "querystring": {
        "select": "SELECT VG.VENDOR_GRP_CODE AS VendorGrpCode, VG.VENDOR_GRP_NAME AS VendorGrpName, VG.IS_ACTIVE AS IsActive, ISNULL(QRY_MBR.JUMLAH_MBR,0) AS NumOfMbr, VG.VENDOR_GRP_ID AS VendorGrpId,VG.MR_VENDOR_CATEGORY_CODE AS MrVendorCategoryCode",
        "from": "FROM VENDOR_GRP VG WITH(NOLOCK) LEFT JOIN (SELECT VENDOR_GRP_ID, V.MR_VENDOR_CATEGORY_CODE, COUNT(0) JUMLAH_MBR FROM VENDOR_GRP_MBR VGM WITH(NOLOCK) INNER JOIN VENDOR V WITH(NOLOCK) ON VGM.VENDOR_ID = V.VENDOR_ID GROUP BY VENDOR_GRP_ID, V.MR_VENDOR_CATEGORY_CODE) QRY_MBR ON VG.VENDOR_GRP_ID = QRY_MBR.VENDOR_GRP_ID AND VG.MR_VENDOR_CATEGORY_CODE = QRY_MBR.MR_VENDOR_CATEGORY_CODE"
    },
