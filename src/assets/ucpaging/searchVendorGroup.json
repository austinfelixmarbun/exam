    "querystring": {
        "select": "SELECT  A.VENDOR_GRP_CODE AS VendorGrpCode, A.VENDOR_GRP_NAME AS VendorGrpName, A.IS_ACTIVE AS IsActive, COUNT(B.VENDOR_GRP_ID) AS NumOfMbr, A.VENDOR_GRP_ID AS VendorGrpId,A.MR_VENDOR_CATEGORY_CODE AS MrVendorCategoryCode",
        "from": "FROM dbo.VENDOR_GRP A WITH(NOLOCK) LEFT JOIN dbo.VENDOR_GRP_MBR B WITH(NOLOCK) ON A.VENDOR_GRP_ID = B.VENDOR_GRP_ID",
        "groupby": "GROUP BY A.VENDOR_GRP_CODE, A.VENDOR_GRP_NAME, A.IS_ACTIVE, A.VENDOR_GRP_ID,A.MR_VENDOR_CATEGORY_CODE "
    },
