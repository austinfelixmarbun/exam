        },
        {
            "type": "textbox",
            "name": "VS.VENDOR_SCHM_NAME",
            "id": "VendorSchemeNameId",
            "value": "",
            "label": "Scheme Name",
            "placeholder": "Placeholder"
        },
        {
            "type": "dropdown",
            "name": "VS.IS_ACTIVE",
            "id": "ActiveStatusId",
