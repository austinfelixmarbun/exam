    ],
    "querystring": {
        "select": "SELECT AM.FULL_ASSET_CODE AS FullAssetCode, AC.ASSET_CATEGORY_NAME AS AssetCategoryName, AM.FULL_ASSET_NAME AS FullAssetName, AM.ASSET_MASTER_ID AS AssetMasterId, AM.IS_ACTIVE AS IsActive",
        "from": "FROM dbo.ASSET_MASTER AM JOIN dbo.ASSET_CATEGORY AC ON AC.ASSET_CATEGORY_ID = AM.ASSET_CATEGORY_ID",
        "where": "WHERE AM.IS_FINAL = 1 AND AM.IS_ACTIVE = 1"
    },
