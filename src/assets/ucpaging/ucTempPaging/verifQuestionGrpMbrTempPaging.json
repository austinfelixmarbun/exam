    "querystring": {
        "select": "SELECT VQA.VERF_QUESTION_ANSWER_ID AS VerfQuestionAnswerId, VQA.REF_VERF_ANSWER_TYPE_ID AS RefAnswerTypeId, VQA.VERF_QUESTION_CODE AS VerfQuestionCode, VQA.VERF_QUESTION_TEXT AS VerfQuestionText, VQA.VERF_ANSWER AS VerfAnswer, VAT.VERF_ANSWER_TYPE_DESCR AS VerfAnswerTypeDescr, VQA.IS_ACTIVE AS IsActive",
        "from": "FROM dbo.VERF_QUESTION_ANSWER VQA WITH(NOLOCK) INNER JOIN dbo.REF_VERF_ANSWER_TYPE VAT WITH(NOLOCK) ON VAT.REF_VERF_ANSWER_TYPE_ID = VQA.REF_VERF_ANSWER_TYPE_ID",
        "where": "WHERE VQA.IS_ACTIVE = 1"
