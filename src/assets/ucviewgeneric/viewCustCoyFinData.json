        "querystring": {
          "select": "SELECT CCFD.GROSS_MONTHLY_INCOME_AMT AS GmiA, CCFD.GROSS_PROFIT_AMT AS GpA, CCFD.RETURN_OF_INVESTMENT_PRCNT AS RoiP, CCFD.RETURN_OF_EQUITY_PRCNT AS RoeP, CCFD.RETURN_OF_ASSET_PRCNT AS RoaP, CCFD.PROFIT_MARGIN_PRCNT AS PmP, CCFD.CURRENT_RATIO_PRCNT AS CrP, CCFD.DEBT_EQUITY_RATIO_PRCNT AS DerP, CCFD.INV_TURN_OVER_PRCNT AS ItoP, CCFD.AR_TURN_OVER_PRCNT AS AtoP, CCFD.GROWTH_PRCNT AS GP, CCFD.WORKING_CAPITAL_AMT AS WcA, CCFD.OTH_MONTHLY_INST_AMT AS OmiA, CCFD.DATE_AS_OF AS Dtao, CCFD.REVENUE AS R, CCFD.OPR_COST AS Oc, CCFD.PROFIT_BEFORE_TAX AS Pbt, CCFD.CURR_ASSET AS Ca, CCFD.NET_FIXED_ASSET AS Nfa, CCFD.TOTAL_ASSET AS Ta, CCFD.CURR_LIABLTS AS Cl, CCFD.LONG_TEMR_LIABLTS AS Ltl, CCFD.SHAREHOLDER_EQUITY AS Se, CCFD.CURR_RATIO AS Cr",
          "from": "FROM dbo.CUST_COMPANY_FIN_DATA CCFD WITH(NOLOCK) JOIN dbo.CUST_COMPANY CC WITH(NOLOCK) ON CC.CUST_COMPANY_ID = CCFD.CUST_COMPANY_ID",
          "where": "WHERE CC.CUST_ID = {0}"
        }
