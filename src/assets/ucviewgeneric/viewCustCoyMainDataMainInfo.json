        "querystring": {
        "select": "SELECT RIT.INDUSTRY_TYPE_NAME AS IndTypeName, CP.NUM_OF_EMP AS NumOfEmp, CP.ESTABLISHMENT_DT AS EstDt,CP.LICENSE_NO AS LisNo, CP.REGISTRATION_NO AS RegNo, C.IS_AFFILIATE_WITH_MF AS IsAff, C.IS_VIP AS IsVip, C.VIP_NOTES AS VipNotes",
          "from": "FROM dbo.CUST AS C WITH(NOLOCK) JOIN dbo.CUST_COMPANY CP WITH(NOLOCK) ON C.CUST_ID = CP.CUST_ID  LEFT JOIN dbo.REF_INDUSTRY_TYPE RIT WITH(NOLOCK) ON CP.REF_INDUSTRY_TYPE_ID = RIT.REF_INDUSTRY_TYPE_ID",
          "where": "WHERE C.CUST_ID = {0}"
        }
