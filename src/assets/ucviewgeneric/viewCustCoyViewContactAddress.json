{
    "title": "",
    "subsection": [
      {
        "subSectionId": "FinDataId",
        "subSectionTitle": "Financial Data",
        "mainInfoUrl": "http://r3app-server.ad-ins.com/FOUNDATION_R3/Generic/GetDataViewBySQL",
        "mainInfo": [
          {
            "type": "text",
            "label": "Address",
            "property": "Fa"
          },
          {
            "type": "text",
            "label": "Zip Code",
            "property": "Z"
          },
          {
            "type": "text",
            "label": "RT / RW",
            "property": "Rr"
          },
          {
            "type": "text",
            "label": "Kelurahan",
            "property": "Kel"
          },
          {
            "type": "text",
            "label": "PHONE NO (FIX LINE) 1",
            "property": "P1"
          },
          {
            "type": "text",
            "label": "Kecamatan",
            "property": "Kec"
          },
          {
            "type": "text",
            "label": "PHONE NO (FIX LINE) 2",
            "property": "P2"
          },
          {
            "type": "text",
            "label": "FAX",
            "property": "F"
          },
          {
            "type": "text",
            "label": "City",
            "property": "Ci"
          }
        ],
        "querystring": {
          "select": "SELECT CA.FULL_ADDR AS Fa, CONCAT(CA.AREA_CODE_4, '/', CA.AREA_CODE_3) AS Rr, CA.AREA_CODE_1 AS Kec, CA.AREA_CODE_2 AS Kel, CA.CITY AS Ci, CA.ZIPCODE AS Z, CONCAT(CA.PHN_AREA_1,' ',CA.PHN_1, '-',CA.PHN_EXT_1) AS P1, CONCAT(CA.PHN_AREA_2,' ',CA.PHN_2, '-',CA.PHN_EXT_2) AS P2, CONCAT(CA.FAX_AREA,' ',CA.FAX) AS F",
          "from": "FROM dbo.CUST_COMPANY_CONTACT_PERSON CCCP JOIN dbo.CUST_COMPANY CC ON CC.CUST_COMPANY_ID = CCCP.CUST_COMPANY_ID JOIN dbo.CUST_ADDR CA ON CA.CUST_ID = CC.CUST_ID AND CA.MR_CUST_ADDR_TYPE_CODE = 'JOB' JOIN dbo.CUST C ON C.CUST_ID = CC.CUST_ID",
          "where": "WHERE C.CUST_ID = {0}"
        }
      }
    ]
  }