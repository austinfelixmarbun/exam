        ],
        "querystring": {
          "select": "SELECT RMBOW.DESCR AS BuildingOwn, CA.FULL_ADDR AS Addr, CONCAT(CA.AREA_CODE_4, '/', CA.AREA_CODE_3) AS RtRw, CA.ZIPCODE AS ZipCode, CA.AREA_CODE_2 AS Kelurahan, CA.AREA_CODE_1 AS Kecamatan, CA.CITY AS City, CONCAT(CA.PHN_AREA_1,' ',CA.PHN_1, '-',CA.PHN_EXT_1) AS Phone1, CONCAT(CA.PHN_AREA_2,' ',CA.PHN_2, '-',CA.PHN_EXT_2) AS Phone2, CONCAT(CA.PHN_AREA_3,' ',CA.PHN_3, '-',CA.PHN_EXT_3) AS Phone3,CONCAT(CA.FAX_AREA,'-', CA.FAX) AS Fax",
          "from": "FROM dbo.CUST_ADDR CA WITH(NOLOCK) LEFT JOIN dbo.REF_MASTER RMBOW WITH(NOLOCK) ON RMBOW.REF_MASTER_TYPE_CODE = 'BUILDING_OWNERSHIP' AND RMBOW.MASTER_CODE = CA.MR_BUILDING_OWNERSHIP_CODE",
          "where": "WHERE MR_CUST_ADDR_TYPE_CODE = 'JOB' AND CUST_ID={0}"
        }
      }
    ]
