          }
        ],
        "querystring": {
          "select": "SELECT CPJD.OTH_BIZ_NAME AS OthBizName, CPJD.OTH_BIZ_TYPE AS OthBizType, RIT.INDUSTRY_TYPE_NAME AS OthBizIndType, CPJD.OTH_BIZ_JOB_POSITION AS OthBizJobPos,  CPJD.OTH_BIZ_ESTABLISHMENT_DT AS OthBizEstDt",
          "from": "FROM dbo.CUST_PERSONAL_JOB_DATA CPJD WITH(NOLOCK) LEFT JOIN dbo.REF_INDUSTRY_TYPE RIT WITH(NOLOCK) ON RIT.INDUSTRY_TYPE_CODE = CPJD.OTH_BIZ_INDUSTRY_TYPE_CODE",
          "where": "WHERE CPJD.CUST_ID = {0}"
        }
      }
    ]
