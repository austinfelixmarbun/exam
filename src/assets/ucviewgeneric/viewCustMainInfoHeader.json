    "title": "",
    "subsection": [
      {
        "subSectionId": "AssetTypeId",
        "subSectionTitle": "Asset Type",
        "mainInfoUrl": "http://r3app-server.ad-ins.com/FOUNDATION_R3/Generic/GetDataViewBySQL",
        "mainInfo": [
          {
            "type": "text",
            "label": "Customer No",
            "property": "CustNo"
          },
          {
            "type": "text",
            "label": "Customer Name",
            "property": "CustName"
          },
          {
            "type": "text",
            "label": "Gender",
            "property": "MrGenderCode"
          },
          {
            "type": "text",
            "label": "Birth Place / Date",
            "property": "BirthPlaceDt"
          },
          {
            "type": "text",
            "label": "ID Type / No",
            "property": "IdTypeNo"
          },
          {
            "type": "text",
            "label": "Id Expired Date",
            "property": "IdExpiredDt"
          },
          {
            "type": "text",
            "label": "NPWP",
            "property": "TaxIdNo"
          }
        ],
        "querystring": {
          "select": "SELECT  C.CUST_NO AS CustNo, C.CUST_ID AS CustId, C.CUST_NAME AS CustName, CP.MR_GENDER_CODE AS MrGenderCode, CONCAT(CP.BIRTH_PLACE, ' ', CONVERT(date, CP.BIRTH_DT)) AS BirthPlaceDt, CONCAT(C.MR_ID_TYPE_CODE ,' ', C.ID_NO ) AS IdTypeNo,  CONVERT(date, C.ID_EXPIRED_DT) AS IdExpiredDt, C.TAX_ID_NO AS TaxIdNo",
          "from": "FROM dbo.CUST AS C WITH(NOLOCK) JOIN dbo.CUST_PERSONAL AS CP WITH(NOLOCK) ON C.CUST_ID = CP.CUST_ID",
          "where": "WHERE C.CUST_ID = {0}"
        }
      }
    ]
  }