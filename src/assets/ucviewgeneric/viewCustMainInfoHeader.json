        "querystring": {
          "select": "SELECT C.CUST_ID, C.CUST_NO AS CustNo, C.CUST_NAME AS CustName, CP.MR_GENDER_CODE AS MrGenderCode, CP.BIRTH_PLACE AS BirthPlace, CP.BIRTH_DT AS BirthDt, C.MR_ID_TYPE_CODE AS MrIdTypeCode, C.ID_NO AS IdNo,  C.ID_EXPIRED_DT AS IdExpiredDt, C.TAX_ID_NO AS TaxIdNo",
          "from": "FROM dbo.CUST AS C WITH(NOLOCK) JOIN dbo.CUST_PERSONAL AS CP WITH(NOLOCK) ON C.CUST_ID = CP.CUST_ID",
