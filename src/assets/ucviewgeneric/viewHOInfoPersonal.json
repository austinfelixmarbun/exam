            "property": "IdNo"
          },
          {
            "type": "text",
            "label": "E-mail",
            "property": "Email"
          },
          {
            "type": "text",
            "label": "Establishment Date",
            "property": "EstablishmentDt"
          },
          {
            "type": "text",
            "label": "Mobile Phone 1",
            "property": "MobilePhnNo1"
          },
          {
            "type": "text",
