{
    "subsection": [
      {
        "subSectionId": "HOInfoId",
        "subSectionTitle": "HO Info",
        "mainInfoPath": "/Generic/GetDataViewBySQL",
        "mainInfo": [
          {
            "type": "link",
            "label": "Supplier Holding:",
            "property": "Parent",
            "name": "LinkSupplierHolding",
            "target": "_blank",
            "path": "/View/Vendor/VendorHolding",
            "param": [
              {
                "type": "VendorId",
                "property": "VendorParentId"
              }
            ]
          }
        ],
        "querystring": {
            "select": "SELECT P.VENDOR_NAME AS Parent, P.VENDOR_ID AS VendorParentId",
            "from": "FROM DBO.VENDOR C JOIN DBO.VENDOR P ON C.VENDOR_PARENT_ID = P.VENDOR_ID", 
            "where": "WHERE C.VENDOR_ID = {0}" 
        }
      }
    ]
  }