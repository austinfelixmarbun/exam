{
    "subsection": [
      {
        "subSectionId": "HOTaxId",
        "subSectionTitle": "Tax Info",
        "mainInfoUrl": "http://r3app-server.ad-ins.com/FOUNDATION_R3/Generic/GetDataViewBySQL",
        "mainInfo": [
          {
            "type": "text",
            "label": "Tax Calculation Method",
            "property": "TaxCalcMethod"
          },
          {},
          {
            "type": "text",
            "label": "VAT",
            "property": "Vat"
          },
          {},
          {
            "type": "text",
            "label": "Tax Payer Number",
            "property": "TaxpayerNo"
          },
          {},
          {
            "type": "text",
            "label": "Tax Payer Name",
            "property": "TaxpayerName"
          }       
        ],
        "querystring": {
            "select": "SELECT RM.DESCR AS TaxCalcMethod, V.IS_VAT AS Vat, V.TAXPAYER_NO AS TaxpayerNo, V.TAXPAYER_NAME AS TaxpayerName",
            "from": "FROM DBO.VENDOR V JOIN DBO.REF_MASTER RM ON RM.MASTER_CODE = V.MR_TAX_CALC_METHOD_CODE AND RM.REF_MASTER_TYPE_CODE = 'TAX_CALC_METHOD'", 
            "where": "WHERE V.VENDOR_ID = {0}" 
        }
      },
      {
        "subSectionId": "HOTaxAddressId",
        "subSectionTitle": "Tax Info",
        "mainInfoUrl": "http://r3app-server.ad-ins.com/FOUNDATION_R3/Generic/GetDataViewBySQL",
        "mainInfo": [
          {
            "type": "text",
            "label": "Tax Address",
            "property": "Addr"
          },
          {},
          {
            "type": "text",
            "label": "Zipcode",
            "property": "Zipcode"
          },
          {},
          {
            "type": "text",
            "label": "Kelurahan",
            "property": "Kelurahan"
          },
          {},
          {
            "type": "text",
            "label": "Kecamatan",
            "property": "Kecamatan"
          },
          {},
          {
            "type": "text",
            "label": "City",
            "property": "City"
          },
          {},
          {
            "type": "text",
            "label": "Province",
            "property": "Province"
          }          
        ],
        "querystring": {
            "select": "SELECT VA.ADDR AS Addr, VA.ZIPCODE AS Zipcode, VA.AREA_CODE_2 AS Kelurahan, VA.AREA_CODE_1 AS Kecamatan, VA.CITY AS City, VA.PROVINCE AS Province",
            "from": "FROM DBO.VENDOR_ADDR VA JOIN DBO.VENDOR V ON VA.VENDOR_ID = V.VENDOR_ID AND MR_ADDR_TYPE_CODE = 'TAX'", 
            "where": "WHERE VA.VENDOR_ID = {0}" 
        }
      }
    ]
  }