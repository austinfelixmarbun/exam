        "subSectionId": "Office Center Group Info",
        "subSectionTitle": "Office Center Group Info",
        "mainInfoPath": "/Generic/GetDataViewBySQL",
        "mainInfo": [
          {
            "type": "text",
            "label": "Office Code",
            "property": "OfficeCode"
          },
          {
            "type": "text",
