{
  "subsection": [
    {
      "subSectionId": "Product Information",
      "subSectionTitle": "Main Information",
      "mainInfoUrl": "http://r3app-server.ad-ins.com/FOUNDATION_R3/Generic/GetDataViewBySQL",
      "mainInfo": [
        {
          "type": "text",
          "label": "Product Code",
          "property": "prodCode"
        },
        {
          "type": "date",
          "label": "Start Active Date",
          "property": "startDt"
        },
        {
          "type": "text",
          "label": "Product Name",
          "property": "prodName"
        },
        {
          "type": "date",
          "label": "End Date",
          "property": "endDt"
        },
        {
          "type": "text",
          "label": "Product Status",
          "property": "prodStat"
        },
        {
          "type": "text",
          "label": "Product Description",
          "property": "prodDescr"
        }

      ],
      "querystring": {
        "select": "SELECT B.PROD_CODE AS prodCode, B.PROD_NAME AS prodName, B.PROD_STAT as prodStat, A.START_DT as startDt, A.END_DT as endDt, B.PROD_DESCR as prodDescr",
        "from": "FROM dbo.PROD_H A WITH(NOLOCK) INNER JOIN dbo.PROD B WITH(NOLOCK) ON A.PROD_ID=B.PROD_ID",
        "where": "WHERE A.PROD_H_ID = {1}"
      }
    }
  ]
}
