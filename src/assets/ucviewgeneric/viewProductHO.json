      "querystring": {
        "select": "SELECT B.PROD_COMPNT_VALUE AS prodCompntValue",
        "from": "FROM dbo.PROD_D A WITH(NOLOCK) INNER JOIN dbo.REF_PROD_COMPNT B WITH(NOLOCK) ON A.REF_PROD_COMPNT_CODE=B.REF_PROD_COMPNT_CODE",
        "where": "WHERE A.PROD_H_ID = {0} AND B.IS_PROD_HO=1 AND B.REF_PROD_COMPNT_GRP_CODE='GEN'"
      }
