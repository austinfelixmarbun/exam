{
  "title": "",
  "subsection": [
    {
      "subSectionId": "ProductInformation",
      "subSectionTitle": "Main Information",
      "mainInfoUrl": "http://r3app-server.ad-ins.com/FOUNDATION_R3/Generic/GetDataViewBySQL",
      "mainInfo": [
        {
          "type": "text",
          "label": "Product Code",
          "property": "prodCode"
        },
        {
          "type": "date",
          "label": "Start Active Date",
          "property": "startDt"
        },
        {
          "type": "text",
          "label": "Product Name",
          "property": "prodName"
        },
        {
          "type": "date",
          "label": "End Date",
          "property": "endDt"
        },
        {
          "type": "text",
          "label": "Product Status",
          "property": "descr"
        },
        {
          "type": "text",
          "label": "Product Description",
          "property": "prodDescr"
        },
        {
          "type": "text",
          "label": "Product HO Version",
          "property": "versionName"
        },
        {
          "type": "date",
          "label": "Deactivate Effective Date",
          "property": "deactDate"
        }

      ],
      "querystring": {
        "select": "SELECT B.PROD_CODE AS prodCode, B.PROD_NAME AS prodName, C.DESCR as descr, A.START_DT as startDt, A.END_DT as endDt, B.PROD_DESCR as prodDescr,CONCAT(A.PROD_VERSION,'/', CASE WHEN A.PROD_H_ID = B.CURRENT_PROD_H_ID THEN 'Current' WHEN A.PROD_H_ID = B.DRAFT_PROD_H_ID THEN 'Draft' ELSE 'Other' END) AS versionName, A.DEACT_EFFECTIVE_DT as deactDate",
        "from": "FROM dbo.PROD_H A WITH(NOLOCK) INNER JOIN dbo.PROD B WITH(NOLOCK) ON A.PROD_ID=B.PROD_ID LEFT JOIN dbo.REF_MASTER C WITH(NOLOCK) ON A.PROD_STAT=C.MASTER_CODE",
        "where": "WHERE A.PROD_H_ID = {0}"
      }
    }
  ]
}
