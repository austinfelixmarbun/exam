        "querystring": {
           "select":"SELECT VENDOR_NAME AS SupplierHo,RESERVED_FIELD_3 AS SuppCalc,MR_VENDOR_CLASS AS SupplierClass,RESERVED_FIELD_5 AS BpkbAging, RESERVED_FIELD_6 AS DAP,RESERVED_FIELD_7 AS MaxRefundType,RESERVED_FIELD_8 AS MaxRefundValue",
            "from":"FROM dbo.VENDOR A WITH(NOLOCK)",
            "where":"WHERE MR_VENDOR_CLASS = 'BRANCH'  AND MR_VENDOR_CATEGORY_CODE LIKE 'SUPPLIER%' AND MR_VENDOR_CATEGORY_CODE NOT LIKE '%HO' AND VENDOR_ID = {0}"
        }
      }
