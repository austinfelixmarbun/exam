      "subSectionId": "MainInformationPId",
      "subSectionTitle": "Main Info",
      "mainInfoUrl": "http://r3app-server.ad-ins.com/FOUNDATION_R3/Generic/GetDataViewBySQL",
      "mainInfo": [
        {
          "type": "text",
          "label": "Id Type :",
          "property": "IdType"
        },
        {
          "type": "text",
          "label": "Rating :",
          "property": "VendorRating"
        },
        {
          "type": "text",
          "label": "Id Number :",
          "property": "IdNo"
        },
        {
          "type": "text",
          "label": "Email :",
          "property": "Email"
        },
        {
          "type": "date",
          "label": "Establishment Date :",
          "property": "EstablishmentDt"
        },
        {
          "type": "text",
          "label": "Mobile Phone 1 :",
          "property": "Mp1"
        },
        {
          "type": "date",
          "label": "Partnership Date :",
          "property": "PartnershipDt"
        },
        {
          "type": "text",
          "label": "Mobile Phone 2 :",
          "property": "Mp2"
        }
      ],
      "querystring": {
        "select": "SELECT B.DESCR AS IdType, ID_NO AS IdNo, A.LICENSE_NO AS LicenseNo, A.ESTABLISHMENT_DT AS EstablishmentDt, A.PARTNERSHIP_DT AS PartnershipDt, A.VENDOR_RATING AS VendorRating, A.EMAIL AS Email, A.MOBILE_PHN_NO_1 AS Mp1, A.MOBILE_PHN_NO_2 AS Mp2",
        "from": "FROM dbo.VENDOR A WITH(NOLOCK) JOIN dbo.REF_MASTER B WITH(NOLOCK) ON A.MR_ID_TYPE_CODE = B.MASTER_CODE",
        "where": "WHERE MR_VENDOR_CLASS = 'BRANCH' AND VENDOR_ID = {0}"
      }
    }
  ]
}