          }
        ],
        "querystring": {
          "select": "SELECT A.ADDR AS TaxAddress, A.ZIPCODE AS ZipCode,A.AREA_CODE_1 AS Kecamatan,A.AREA_CODE_2 AS Kelurahan, A.CITY AS City,A.PROVINCE AS Province",
              "from":"FROM dbo.VENDOR_ADDR A WITH (NOLOCK) LEFT JOIN dbo.VENDOR B WITH(NOLOCK) ON B.VENDOR_ID = A.VENDOR_ID",
              "where":"WHERE B.MR_VENDOR_CLASS = N'BRANCH' AND A.MR_ADDR_TYPE_CODE= N'TAX' AND B.VENDOR_ID = {0}"
              
        }
      }
    ]
  }
  