{
    "subsection": [
        {
            "subSectionId": "Vendor Group Member Information",
            "subSectionTitle": "VENDOR GROUP MEMBER",
            "mainInfoPath": "/Generic/GetDataViewBySQL",
            "mainInfo": [
                {
                    "type": "text",
                    "label": "Vendor Category",
                    "property": "Descri"
                },
                {
                    "type": "boolean",
                    "label": "Active Status",
                    "property": "IsActive"
                },
                {
                    "type": "text",
                    "label": "Group Code",
                    "property": "VendorGrpCode"
                },
                {
                    "type": "text",
                    "label": "Group Name",
                    "property": "VendorGrpName"
                }
            ],
            "querystring": {
                "select":"SELECT  C.DESCR AS Descri, A.VENDOR_GRP_CODE AS VendorGrpCode,A.VENDOR_GRP_NAME AS VendorGrpName, A.IS_ACTIVE AS IsActive",
               "from": "FROM dbo.VENDOR_GRP A WITH(NOLOCK) LEFT JOIN dbo.REF_MASTER C WITH(NOLOCK) ON C.MASTER_CODE = A.MR_VENDOR_CATEGORY_CODE AND C.REF_MASTER_TYPE_CODE = 'VENDOR_CATEGORY'",
                "where":"WHERE A.VENDOR_GRP_ID = {0}"
            }
        }
    ]
}