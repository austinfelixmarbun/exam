    "subsection": [
      {
        "subSectionId": "LatLongId",
        "subSectionTitle": "Lat Long Info",
        "mainInfoPath": "/Generic/GetDataViewBySQL",
        "mainInfo": [
          {
            "type": "text",
            "label": "Latitude:",
            "property": "Latitude"
          },
          {
            "type": "text",
            "label": "Longitude:",
            "property": "Longitude"
          }
        ],
        "querystring": {
          "select":  "SELECT A.LATITUDE AS Latitude,A.LONGITUDE Longitude",
          "from":"FROM dbo.VENDOR_ADDR A WITH (NOLOCK) LEFT JOIN dbo.VENDOR B WITH(NOLOCK) ON B.VENDOR_ID = A.VENDOR_ID",
          "where":"WHERE B.MR_VENDOR_CLASS = N'HOLDING' AND A.MR_ADDR_TYPE_CODE = N'LEGAL' AND B.VENDOR_ID = {0}"
            
        }
      }
    ]
  }
  