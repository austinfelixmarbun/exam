        "querystring": {
         "select":   "SELECT MR_TAX_CALC_METHOD_CODE AS TaxCalculationMethod,IS_VAT AS Vat,TAXPAYER_NO AS TaxNo,TAXPAYER_NAME AS TaxName",
           "from": "FROM dbo.VENDOR WITH(NOLOCK)",
           "where": "WHERE MR_VENDOR_CLASS = 'HOLDING' AND VENDOR_ID = {0}"
        }
