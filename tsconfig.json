{
  "compileOnSave": false,
  "compilerOptions": {
    "downlevelIteration": true,
    "module": "ESNext",
    "esModuleInterop": true,
    "outDir": "./dist/out-tsc",
    "baseUrl": "src",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "target": "ES6",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2016",
      "dom"
    ],
    "resolveJsonModule": true
  },
  "angularCompilerOptions": {
    "preserveWhitespaces": false,    
    "enableIvy": true
  }
}